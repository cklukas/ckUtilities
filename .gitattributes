#
# Every checkout gets LF line endings. Golden dumps and screenshots are
# compared byte for byte, and Windows runners check out with CRLF conversion
# by default, which would break every golden comparison there.
* text=auto eol=lf
*.dump text eol=lf
*.svg text eol=lf
*.png binary
